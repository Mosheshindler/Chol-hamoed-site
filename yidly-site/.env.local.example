# Contact form: messages are emailed to CONTACT_TO through Resend (resend.com).
# Without a key the form shows a fallback asking people to email info@yidly.co directly.
# Server-only — never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_TO=info@yidly.co
# The "from" address must be on a domain verified in Resend (e.g. yidly.co).
CONTACT_FROM=Yidly Website <website@yidly.co>
