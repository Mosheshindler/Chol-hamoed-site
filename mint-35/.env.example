# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the site, used in email links
NEXT_PUBLIC_SITE_URL=https://mint35.com

# Email (Resend). Without a key, emails are skipped and logged.
RESEND_API_KEY=
EMAIL_FROM=Mint 35 <hello@mint35.com>
TEAM_NOTIFY_EMAIL=info@mintmediallc.com

# QuickBooks Payments (developer.intuit.com → your app → Keys & credentials)
# Use the Development (sandbox) keys with QB_ENVIRONMENT=sandbox for testing,
# then the Production keys with QB_ENVIRONMENT=production to take real payments.
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_ENVIRONMENT=sandbox
